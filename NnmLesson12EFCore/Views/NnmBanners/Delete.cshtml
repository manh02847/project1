@model NnmLesson12EFCore.Models.NnmBanner
@{ ViewData["Title"] = "Xóa banner"; }

<h1>@ViewData["Title"]</h1>
<p class="text-danger">Bạn có chắc muốn xóa dữ liệu này?</p>
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<hr />
<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NnmName)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => Model.NnmName)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NnmImage)</dt>
    <dd class="col-sm-9">@if (!string.IsNullOrEmpty(Model.NnmImage))
                {
                    <img src="~/Banner/@Model.NnmImage" alt="Ảnh" class="item-image" />
                }</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NnmDescription)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => Model.NnmDescription)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NnmStatus)</dt>
    <dd class="col-sm-9">@(Model.NnmStatus == 1 ? "Hiển thị" : "Ẩn")</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NnmCreatedDate)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => Model.NnmCreatedDate)</dd>
</dl>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>
