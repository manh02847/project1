<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NnmLesson12EFCore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NnmLesson12EFCore.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="NnmHome" asp-action="NnmIndex">Lesson12</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="NnmHome" asp-action="NnmIndex">Trang chủ</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="NnmHome" asp-action="Product">Xem sản phẩm</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="NnmCategories" asp-action="Index">Danh mục</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="NnmProducts" asp-action="Index">Sản phẩm</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="NnmBanners" asp-action="Index">Banner</a></li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="nnmStudentMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">Quản lý sinh viên</a>
                            <ul class="dropdown-menu" aria-labelledby="nnmStudentMenu">
                                <li><a class="dropdown-item" asp-controller="NnmStdClasses" asp-action="Index">Lớp học</a></li>
                                <li><a class="dropdown-item" asp-controller="NnmStudents" asp-action="Index">Sinh viên</a></li>
                                <li><a class="dropdown-item" asp-controller="NnmSubjects" asp-action="Index">Môn học</a></li>
                                <li><a class="dropdown-item" asp-controller="NnmMarks" asp-action="Index">Điểm</a></li>
                            </ul>
                        </li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="NnmHome" asp-action="NnmAbout">Thông tin</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Nguyễn Ngọc Mạnh - K24-CNT2
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
