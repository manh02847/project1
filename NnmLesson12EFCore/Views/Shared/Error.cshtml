@model ErrorViewModel
@{ ViewData["Title"] = "Có lỗi xảy ra"; }
<h1 class="text-danger">Có lỗi xảy ra</h1>
<p>Không thể xử lý yêu cầu. Vui lòng thử lại.</p>
@if (Model.ShowRequestId)
{
    <p>Mã yêu cầu: <code>@Model.RequestId</code></p>
}
<a asp-controller="NnmHome" asp-action="NnmIndex" class="btn btn-primary">Về trang chủ</a>
