<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Customer</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="customer-header">
        <div class="container header-inner">
            <strong>CUSTOMER</strong>
            <nav class="main-nav">
                <a asp-area="Customer" asp-controller="Home" asp-action="Index">Trang khách hàng</a>
                <a asp-area="" asp-controller="NnmProducts" asp-action="Index">Sản phẩm</a>
                <a asp-area="" asp-controller="NnmHome" asp-action="Index">Trang chủ</a>
            </nav>
        </div>
    </header>
    <main class="container main-content">
        @RenderBody()
    </main>
    <script src="~/js/NnmLayout.js" asp-append-version="true"></script>
</body>
</html>
