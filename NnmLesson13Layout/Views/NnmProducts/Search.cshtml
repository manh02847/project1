@{
    ViewData["Title"] = "Tìm kiếm sản phẩm";
    Layout = "~/Views/Shared/_NnmLayoutProduct.cshtml";
    var keyword = ViewData["Keyword"] as string;
}

<h2>Tìm kiếm sản phẩm</h2>
<form method="get" class="search-form">
    <input type="text" name="keyword" value="@keyword" placeholder="Nhập từ khóa" />
    <button type="submit">Tìm kiếm</button>
</form>

@if (!string.IsNullOrWhiteSpace(keyword))
{
    <p class="search-result">Từ khóa đang tìm: <strong>@keyword</strong></p>
}
