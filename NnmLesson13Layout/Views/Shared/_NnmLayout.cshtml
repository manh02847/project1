<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NnmLesson13Layout</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" asp-area="" asp-controller="NnmHome" asp-action="Index">NNM Lesson13</a>
            <nav class="main-nav">
                <a asp-area="" asp-controller="NnmHome" asp-action="Index">Trang chủ</a>
                <a asp-area="" asp-controller="NnmProducts" asp-action="Index">Sản phẩm</a>
                <a asp-area="Admin" asp-controller="Home" asp-action="Index">Admin</a>
                <a asp-area="Customer" asp-controller="Home" asp-action="Index">Customer</a>
                <a asp-area="" asp-controller="NnmHome" asp-action="About">Thông tin</a>
            </nav>
        </div>
    </header>

    <main class="container main-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">&copy; 2026 - Nguyễn Ngọc Mạnh - K24-CNT2</div>
    </footer>

    <script src="~/js/NnmLayout.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
