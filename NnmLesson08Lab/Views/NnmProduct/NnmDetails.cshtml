@model NnmLesson08Lab.Models.NnmProduct
@using NnmLesson08Lab.Models

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<h1>Chi tiết sản phẩm</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">Mã sản phẩm</dt>
    <dd class="col-sm-9">@Model.NnmProductId</dd>
    <dt class="col-sm-3">Tên sản phẩm</dt>
    <dd class="col-sm-9">@Model.NnmProductName</dd>
    <dt class="col-sm-3">Giá</dt>
    <dd class="col-sm-9">@Model.NnmPrice.ToString("N0")</dd>
    <dt class="col-sm-3">Giá khuyến mại</dt>
    <dd class="col-sm-9">@Model.NnmSalePrice.ToString("N0")</dd>
    <dt class="col-sm-3">Danh mục</dt>
    <dd class="col-sm-9">@NnmDataLocal.NnmGetCategoryName(Model.NnmCategoryId)</dd>
    <dt class="col-sm-3">Trạng thái</dt>
    <dd class="col-sm-9">@(Model.NnmStatus ? "Hoạt động" : "Không hoạt động")</dd>
    <dt class="col-sm-3">Ngày tạo</dt>
    <dd class="col-sm-9">@Model.NnmCreatedDate.ToString("dd/MM/yyyy")</dd>
    <dt class="col-sm-3">Mô tả</dt>
    <dd class="col-sm-9">@Model.NnmDescription</dd>
    <dt class="col-sm-3">Hình ảnh</dt>
    <dd class="col-sm-9">
        @if (!string.IsNullOrEmpty(Model.NnmImage))
        {
            <img src="@Model.NnmImage" alt="@Model.NnmProductName" width="160" />
        }
    </dd>
</dl>

<a asp-action="NnmEdit" asp-route-id="@Model.NnmProductId" class="btn btn-primary">Sửa</a>
<a asp-action="Index" class="btn btn-secondary">Quay lại</a>
