@model NguyenNgocManh2410900051_exam.Models.NguyenNgocManhStudent
@{ ViewData["Title"] = "Chi tiết sinh viên"; }

<h1 class="fw-bold mb-4">Chi tiết sinh viên</h1>
<div class="card border-0 shadow-sm"><div class="card-body p-4">
    <dl class="row mb-4">
        <dt class="col-sm-4">Họ và tên</dt><dd class="col-sm-8">@Model.NguyenNgocManhName</dd>
        <dt class="col-sm-4">Giới tính</dt><dd class="col-sm-8">@Model.NguyenNgocManhGender</dd>
        <dt class="col-sm-4">Ngày sinh</dt><dd class="col-sm-8">@Model.NguyenNgocManhBirthDay?.ToString("dd/MM/yyyy")</dd>
        <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.NguyenNgocManhEmail</dd>
        <dt class="col-sm-4">Số điện thoại</dt><dd class="col-sm-8">@Model.NguyenNgocManhPhone</dd>
        <dt class="col-sm-4">Trạng thái</dt><dd class="col-sm-8">@(Model.NguyenNgocManhActive ? "Đang học" : "Ngừng học")</dd>
    </dl>
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Sửa</a> <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
</div></div>
