@model NnmLesson07Models.Models.DataModels.NnmMember

@{
    ViewData["Title"] = "Create";
}

<div class="card p-3">
    <h1>Thêm mới thành viên</h1>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <form asp-action="Create" method="post" asp-controller="NnmMember">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="NnmMemberId" class="control-label"></label>
                    <input asp-for="NnmMemberId" class="form-control" />
                    <span asp-validation-for="NnmMemberId" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="NnmUserName" class="control-label"></label>
                    <input asp-for="NnmUserName" class="form-control" />
                    <span asp-validation-for="NnmUserName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="NnmPassword" class="control-label"></label>
                    <input asp-for="NnmPassword" class="form-control" />
                    <span asp-validation-for="NnmPassword" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="NnmFullName" class="control-label"></label>
                    <input asp-for="NnmFullName" class="form-control" />
                    <span asp-validation-for="NnmFullName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="NnmEmail" class="control-label"></label>
                    <input asp-for="NnmEmail" class="form-control" />
                    <span asp-validation-for="NnmEmail" class="text-danger"></span>
                </div>
                <div class="form-group my-2">
                    <input type="submit" value="Ghi lại" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>
