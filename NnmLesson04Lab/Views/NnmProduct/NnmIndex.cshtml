@{
    ViewData["Title"] = "Danh sách sản phẩm";
    var categories = ViewBag.NnmCategories as List<NnmCategory> ?? new List<NnmCategory>();
    var products = ViewBag.NnmProducts as List<NnmProduct> ?? new List<NnmProduct>();
    int? selectedCategoryId = ViewBag.SelectedCategoryId;
}

<div class="row">
    <div class="col-md-3">
        <h4>DANH MỤC</h4>
        <div class="list-group">
            <a asp-route="nnmproduct" class="list-group-item list-group-item-action @(selectedCategoryId == null ? "active" : "")">
                Tất cả sản phẩm
            </a>
            @foreach (var category in categories)
            {
                <a asp-route="nnmproduct" asp-route-categoryId="@category.Id"
                   class="list-group-item list-group-item-action @(selectedCategoryId == category.Id ? "active" : "")">
                    @category.Name
                </a>
            }
        </div>
    </div>

    <div class="col-md-9">
        <h2>Danh sách sản phẩm</h2>
        <div class="row">
            @foreach (var product in products)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <img src="@product.Image" alt="@product.Name" class="card-img-top nnm-product-image" />
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@product.Name</h5>
                            <p class="mb-1">
                                <del>@product.Price.ToString("N0") đ</del>
                                <strong class="text-danger">@product.SalePrice.ToString("N0") đ</strong>
                            </p>
                            <a asp-route="nnmproductdetail" asp-route-id="@product.Id"
                               class="btn btn-success mt-auto">Chi tiết</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
