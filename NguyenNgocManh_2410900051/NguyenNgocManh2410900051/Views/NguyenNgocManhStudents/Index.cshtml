@model IEnumerable<NguyenNgocManh2410900051.Models.NguyenNgocManhStudent>
@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div><span class="eyebrow">QUẢN LÝ</span><h1 class="fw-bold mb-0">Danh sách sinh viên</h1></div>
    <a class="btn btn-primary" asp-action="Create">+ Thêm sinh viên</a>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-6"><input class="form-control" type="search" name="search" value="@ViewBag.Search" placeholder="Tìm theo họ tên, giới tính, email hoặc số điện thoại" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary" type="submit">Tìm kiếm</button></div>
    @if (!string.IsNullOrWhiteSpace((string?)ViewBag.Search)) { <div class="col-auto"><a class="btn btn-outline-secondary" asp-action="Index">Xóa lọc</a></div> }
</form>

<div class="card border-0 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Họ và tên</th><th>Giới tính</th><th>Ngày sinh</th><th>Email</th><th>Điện thoại</th><th>Trạng thái</th><th></th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold">@item.NguyenNgocManhName</td>
                    <td>@item.NguyenNgocManhGender</td>
                    <td>@item.NguyenNgocManhBirthDay?.ToString("dd/MM/yyyy")</td>
                    <td>@item.NguyenNgocManhEmail</td>
                    <td>@item.NguyenNgocManhPhone</td>
                    <td><span class="badge @(item.NguyenNgocManhActive ? "text-bg-success" : "text-bg-secondary")">@(item.NguyenNgocManhActive ? "Đang học" : "Ngừng học")</span></td>
                    <td class="text-nowrap"><a asp-action="Details" asp-route-id="@item.Id">Xem</a> · <a asp-action="Edit" asp-route-id="@item.Id">Sửa</a> · <a class="text-danger" asp-action="Delete" asp-route-id="@item.Id">Xóa</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (!Model.Any()) { <div class="p-4 text-center text-muted">Chưa có sinh viên phù hợp.</div> }
</div>
