@model NnmLesson10EFDbFirst.Models.NnmMember

@{
    ViewData["Title"] = "Xóa thành viên";
}

<h1>@ViewData["Title"]</h1>
<h4>Bạn có chắc chắn muốn xóa thành viên này?</h4>
<hr />

<dl class="row">
    <dt class="col-sm-3">Tên đăng nhập</dt>
    <dd class="col-sm-9">@Model.NnmUserName</dd>

    <dt class="col-sm-3">Họ và tên</dt>
    <dd class="col-sm-9">@Model.NnmFullName</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.NnmEmail</dd>

    <dt class="col-sm-3">Số điện thoại</dt>
    <dd class="col-sm-9">@Model.NnmPhone</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Xóa</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>
