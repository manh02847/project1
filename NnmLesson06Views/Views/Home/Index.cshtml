@model IEnumerable<Product>

@{
    ViewData["Title"] = "View trong ASP.NET Core MVC - Part 2";
}

<h1>@ViewData["Title"]</h1>
<hr />

<div class="row">
    <div class="col-md-3">
        <h2>View Component</h2>
        @await Component.InvokeAsync("Category", new { n = 0 })
    </div>
    <div class="col-md-9">
        <h2>Partial View</h2>
        <partial name="_ProductHotPartialView" model="Model" />

        <hr />
        <button id="btnLoad" class="btn btn-primary" data-url="@Url.Action("GetProductHot", "Home")">
            Tải sản phẩm bằng Ajax
        </button>
        <div id="productHot" class="mt-3"></div>
    </div>
</div>

@section S1 {
    <span class="alert alert-success">Nguyễn Ngọc Mạnh - 2410900051 - K24-CNT2</span>
}

@section Scripts {
    <script>
        $(function () {
            $("#btnLoad").click(function () {
                $("#productHot").load($(this).data("url"));
            });
        });
    </script>
}
